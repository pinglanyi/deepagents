# ── Deep RAG Agent — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.

# RAGFlow connection
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here

# LLM (defaults to DeepSeek; override with any OpenAI-compatible endpoint)
DEEP_RAG_MODEL=deepseek-chat
DEEP_RAG_API_KEY=your_deepseek_api_key_here
DEEP_RAG_BASE_URL=https://api.deepseek.com

# Alternatively, use Anthropic / OpenAI directly:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Persistent storage directory for files and long-term memory (/AGENTS.md)
# Defaults to ./agent_data relative to the project root
AGENT_DATA_DIR=./agent_data

# Conversation history persistence
# ─────────────────────────────────────────────────────────────────────────────
# `langgraph dev` ALWAYS uses in-memory SQLite (langgraph_runtime_inmem).
# Conversation history is lost on every restart regardless of env-var settings.
#
# POSTGRES_URI, LANGGRAPH_CHECKPOINTER, and LS_DEFAULT_CHECKPOINTER_BACKEND are
# read by langgraph_runtime_postgres, which is closed-source and only present
# inside the LangGraph Platform production Docker image. They have NO effect
# under `langgraph dev`.
#
# To get persistent conversation history you have two options:
#
#   1. Deploy to LangGraph Platform (managed Postgres, set POSTGRES_URI there):
#        https://docs.langchain.com/langgraph-platform/deployment-options
#
#   2. Run interactively: `uv run agent.py`  (terminal mode, own checkpointer)
#
# The variables below are provided for reference when deploying to Platform:
# POSTGRES_URI=postgresql://user:password@localhost:5432/deeprag
# LANGGRAPH_CHECKPOINTER={"backend": "default"}

# LangSmith (required for langgraph dev / LangGraph Studio)
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
