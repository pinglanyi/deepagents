# ── Deep RAG Multi-user Backend — Environment Variables ──────────────────────
# Copy to .env and fill in your values.

# ── Database (required) ───────────────────────────────────────────────────────
# PostgreSQL connection for both the user/thread tables and LangGraph checkpoints.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deeprag

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
# Access token lifetime in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── RAGFlow ───────────────────────────────────────────────────────────────────
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here

# Knowledge base dataset name substrings (used to identify KB type by dataset name).
# A dataset whose name contains the substring is treated as that KB type.
# Defaults are: 产品库 / 图片库 / 文件库 / 视频库 / 通用库 / 程序库 / 经验库
PRODUCT_KB_NAME=产品库
IMAGE_KB_NAME=图片库
FILE_KB_NAME=文件库
VIDEO_KB_NAME=视频库
GENERAL_KB_NAME=通用库
PROGRAM_KB_NAME=程序库
EXPERIENCE_KB_NAME=经验库

# Path to a JSON file with model number aliases/abbreviations.
# Format: {"aliases": {"FULL_MODEL_NUMBER": ["alias1", "alias2"], ...}}
# Leave empty or omit to skip model completion.
# MODEL_ALIASES_FILE=./agent_data/model_aliases.json

# ── LLM (defaults to DeepSeek; any OpenAI-compatible endpoint works) ─────────
DEEP_RAG_MODEL=deepseek-chat
DEEP_RAG_API_KEY=your_deepseek_api_key_here
DEEP_RAG_BASE_URL=https://api.deepseek.com

# Alternatively use Anthropic or OpenAI:
# DEEP_RAG_MODEL=claude-sonnet-4-5
# DEEP_RAG_API_KEY=your_anthropic_api_key
# DEEP_RAG_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_key

# ── Storage ───────────────────────────────────────────────────────────────────
# Local directory for agent files and long-term memory (/AGENTS.md)
AGENT_DATA_DIR=./agent_data

# ── Batch upload throttling ────────────────────────────────────────────────────
# Max concurrent batch-upload requests (FIFO queue beyond this limit).
BATCH_UPLOAD_MAX_CONCURRENT=1
# Seconds to wait between files within one batch (lets RAGFlow breathe).
BATCH_UPLOAD_COOLDOWN_SECONDS=2.0

# ── MinIO / S3 (RAGFlow built-in MinIO) ──────────────────────────────────────
# RAGFlow internally stores all uploaded documents in MinIO. Configure the
# built-in MinIO credentials here to generate presigned download URLs that
# point directly to the source file (usable as <img src>, <video src>, or
# <a href> on the frontend). Leave MINIO_ACCESS_KEY empty to fall back to
# the legacy RAGFlow document preview URL.
#
# RAGFlow's default MinIO credentials (bundled in docker-compose):
#   MINIO_ENDPOINT=localhost:9000
#   MINIO_ACCESS_KEY=minioadmin
#   MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Set to true if MinIO is behind TLS/HTTPS
MINIO_SECURE=false
# Presigned URL validity duration (seconds). Default: 3600 (1 hour).
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins. Use specific origins in production.
# CORS_ORIGINS=["https://your-frontend.com","https://admin.your-frontend.com"]
CORS_ORIGINS=["*"]

# ── LangSmith (optional — for LangGraph Studio tracing) ──────────────────────
# LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
