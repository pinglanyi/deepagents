# ── Deep RAG Agent — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.

# RAGFlow connection
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here

# LLM (defaults to DeepSeek; override with any OpenAI-compatible endpoint)
DEEP_RAG_MODEL=deepseek-chat
DEEP_RAG_API_KEY=your_deepseek_api_key_here
DEEP_RAG_BASE_URL=https://api.deepseek.com

# Alternatively, use Anthropic / OpenAI directly:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# LangSmith (required for langgraph dev / LangGraph Studio)
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
