# ── Deep RAG Agent — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.

# RAGFlow connection
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here

# LLM (defaults to DeepSeek; override with any OpenAI-compatible endpoint)
DEEP_RAG_MODEL=deepseek-chat
DEEP_RAG_API_KEY=your_deepseek_api_key_here
DEEP_RAG_BASE_URL=https://api.deepseek.com

# Alternatively, use Anthropic / OpenAI directly:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Persistent storage directory for files and long-term memory (/AGENTS.md)
# Defaults to ./agent_data relative to the project root
AGENT_DATA_DIR=./agent_data

# Conversation history persistence (optional)
# By default langgraph dev uses in-memory SQLite — conversation history is lost on restart.
# To persist conversation history across restarts, set BOTH variables below:
#
#   POSTGRES_URI       — connection string for your Postgres database
#   LANGGRAPH_CHECKPOINTER — tells langgraph_api to activate the Postgres backend
#
# Without LANGGRAPH_CHECKPOINTER, POSTGRES_URI is silently ignored even if set.
#
# POSTGRES_URI=postgresql://user:password@localhost:5432/deeprag
# LANGGRAPH_CHECKPOINTER={"backend": "default"}

# LangSmith (required for langgraph dev / LangGraph Studio)
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
